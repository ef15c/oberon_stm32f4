MODULE bugOM4;

  PROCEDURE Int*(): INTEGER;
    VAR i: LONGINT;
    RETURN 0 + i
  END Int;

  PROCEDURE Longint*(): LONGINT;
    VAR i: INTEGER;
    RETURN 0L + i
  END Longint;

  PROCEDURE Integer*(): INTEGER;
    VAR i: INTEGER;
    RETURN 0 + i
  END Integer;

  PROCEDURE Halfword*(): HALFWORD;
    VAR i: INTEGER;
    RETURN 0M + i
  END Halfword;

  PROCEDURE Byte*(): BYTE;
    VAR i: INTEGER;
    RETURN 0S + i
  END Byte;

END bugOM4.

OM4P.Compile bugOM4.Mod/s~
System.Free bugOM4~
bugOM4.Check

OM4Tool.DecObj bugOM4.m4c
decode bugOM4.m4c
