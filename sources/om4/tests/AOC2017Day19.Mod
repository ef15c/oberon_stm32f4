MODULE AOC2017Day19;
  IMPORT Texts, Oberon, U := AOCUtils, Log := SystemLog;

  TYPE Map = RECORD a: ARRAY 202, 202 OF CHAR; w, h: INTEGER END;

  VAR W: Texts.Writer;
    map: Map;

  PROCEDURE parse(VAR m: Map);
    VAR S!: Texts.Scanner; i: INTEGER; c: CHAR;
  BEGIN Texts.OpenScanner(S, Oberon.Par.text, Oberon.Par.pos);
    REPEAT Texts.Read(S, c) UNTIL c = Texts.CR; Texts.Read(S, c);
    m.h := 0; m.w := 0;
    WHILE c = " " DO i := 0;
      REPEAT m.a[m.h, i] := c; Texts.Read(S, c); INC(i) UNTIL c = Texts.CR; Texts.Read(S, c);
      IF i > m.w THEN m.w := i END;
      INC(m.h);
    END; ASSERT(c = "~")
  END parse;

  PROCEDURE parts*;
    VAR ls: ARRAY 26 OF CHAR; pls: INTEGER;
      p: U.Vector; dir, i, steps: INTEGER; c: CHAR;
  BEGIN parse(map); pls := 0; p.y := 0;
    i := 0; WHILE (i < map.w) & (map.a[0, i] # "|") DO INC(i) END; ASSERT(i < map.w);
(*Log.DebugInt("entry column", i, 1);*)
    p.x := i; dir := 2; steps := 0;
    (*walk on path*)
    REPEAT c := map.a[p.y, p.x];
(*Log.DebugInt("p.x", p.x, 1); Log.DebugInt("p.y", p.y, 1);*)
      IF (c >= "A") & (c <= "Z") THEN (*collect a letter*) ls[pls] := c; INC(pls)
(*;Log.DebugChar("collect", c);*)
      ELSIF c = "+" THEN (*changement of direction*)
        IF dir = U.NORTH THEN
          IF map.a[p.y, p.x+1] # " " THEN dir := U.EAST
          ELSE ASSERT(map.a[p.y, p.x-1] # " "); dir := U.WEST
          END
        ELSIF dir = U.EAST THEN
          IF map.a[p.y+1, p.x] # " " THEN dir := U.SOUTH
          ELSE ASSERT(map.a[p.y-1, p.x] # " "); dir := U.NORTH
          END
        ELSIF dir = U.SOUTH THEN
          IF map.a[p.y, p.x+1] # " " THEN dir := U.EAST
          ELSE ASSERT(map.a[p.y, p.x-1] # " "); dir := U.WEST
          END
        ELSIF dir = U.WEST THEN
          IF map.a[p.y+1, p.x] # " " THEN dir := U.SOUTH
          ELSE ASSERT(map.a[p.y-1, p.x] # " "); dir := U.NORTH
          END
        END
(*;Log.DebugInt("steps", steps, 1)*)
      END;
      INC(p.x, U.DIRECTION4[dir].x); INC(p.y, U.DIRECTION4[dir].y); INC(steps)
    UNTIL c = " ";
    ls[pls] := 0X;
    Texts.WriteString(W, "Partie 1: letters seen = "); Texts.WriteString(W, ls); Texts.WriteLn(W);
    Texts.WriteString(W, "Partie 2: number of steps = "); Texts.WriteInt(W, steps - 1, 1); Texts.WriteLn(W);
    Texts.Append(Oberon.Log, W.buf)
  END parts;

BEGIN Texts.OpenWriter(W)
END AOC2017Day19.

Oberon.Batch
  OM4P.Compile AOC2017Day19.Mod/s~
  System.Free AOC2017Day19 AOCUtils~
~

Partie 1: letters seen = ABCDEF
Partie 2: number of steps = 38
